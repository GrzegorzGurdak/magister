{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/gcc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/msys64/mingw64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/mingw64/bin/g++.exe",
        "CMAKE_PREFIX_PATH": "C:/msys64/mingw64"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/gcc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "C:/msys64/mingw64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/mingw64/bin/g++.exe",
        "CMAKE_PREFIX_PATH": "C:/msys64/mingw64"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/msys64/mingw64/bin/clang.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/mingw64/bin/clang++.exe",
        "CMAKE_PREFIX_PATH": "C:/msys64/mingw64"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "C:/msys64/mingw64/bin/clang.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/mingw64/bin/clang++.exe",
        "CMAKE_PREFIX_PATH": "C:/msys64/mingw64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-gcc",
      "configurePreset": "gcc-debug"
    },
    {
      "name": "build-clang",
      "configurePreset": "clang-debug"
    },
    {
      "name": "build-gcc-release",
      "configurePreset": "gcc-release"
    },
    {
      "name": "build-clang-release",
      "configurePreset": "clang-release"
    }
  ]
}
